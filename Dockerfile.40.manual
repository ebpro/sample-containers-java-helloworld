# ============================================================
# Stage 1: Build Environment (Manual Toolchain)
# Purpose: Demonstrate manual, reproducible toolchain provisioning:
#          the JDK is pinned by the base image tag and Maven by a
#          pinned Apache release tarball — combined with fixed
#          UID/GID file ownership for high-security CI.
# ============================================================
FROM eclipse-temurin:25-jdk-noble AS stage-build

# Toolchain versioning for reproducible builds
# (the JDK itself is pinned by the eclipse-temurin base image tag)
ARG MAVEN_VERSION="3.9.16"
ARG BUILDER_UID=2000
ARG BUILDER_GID=2000

LABEL maintainer="Emmanuel Bruno <emmanuel.bruno@univ-tln.fr>"
LABEL description="Java Hello World Application - manual toolchain build"

# ------------------------------------------------------------
# OS Layer: Provision tools to fetch and verify the pinned
#           Apache Maven release (and to run the Maven wrapper).
# ------------------------------------------------------------
RUN apt-get update && \
    apt-get install --yes --quiet --no-install-recommends \
      ca-certificates curl unzip zip bash && \
    rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Security: Create dedicated builder user with deterministic UID/GID
# ------------------------------------------------------------
RUN groupadd -g ${BUILDER_GID} builder \
    && useradd -m -u ${BUILDER_UID} -g builder -s /bin/bash builder

# ------------------------------------------------------------
# Toolchain: Install a pinned Apache Maven release from the
#           official archive into a fixed prefix. Bounded 3-attempt
#           retry; fails loud if the tarball is missing or broken.
#           Runs as root so /opt/maven stays readable by the
#           unprivileged builder user.
# ------------------------------------------------------------
RUN MAVEN_HOME=/opt/maven; \
    MAVEN_TGZ="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz"; \
    for attempt in 1 2 3; do \
        echo ">> Apache Maven ${MAVEN_VERSION}: attempt ${attempt}/3" && \
        if curl -fsSL --connect-timeout 15 --max-time 300 -o /tmp/apache-maven.tar.gz "$MAVEN_TGZ" && \
           tar -xzf /tmp/apache-maven.tar.gz -C /opt && \
           mv /opt/apache-maven-${MAVEN_VERSION} "$MAVEN_HOME" && \
           "$MAVEN_HOME/bin/mvn" -version; then \
            break; \
        fi; \
        echo ">> attempt ${attempt} failed; removing partial Maven install before retry" && \
        rm -rf /tmp/apache-maven.tar.gz "$MAVEN_HOME"; \
    done && \
    [ -x "$MAVEN_HOME/bin/mvn" ] || { echo "ERROR: Apache Maven ${MAVEN_VERSION} install failed after 3 attempts" >&2; exit 1; }

USER builder
ENV HOME=/home/builder
ENV PATH="/opt/maven/bin:${PATH}"

SHELL ["/bin/bash", "-c"]

WORKDIR /app

# ------------------------------------------------------------
# Layer: Dependency Resolution (BuildKit Cached)
# ------------------------------------------------------------
COPY --chown=builder:builder mvnw ./
COPY --chown=builder:builder .mvn .mvn
COPY --chown=builder:builder pom.xml ./

RUN --mount=type=cache,target=/home/builder/.m2,uid=${BUILDER_UID},gid=${BUILDER_GID} \
    ./mvnw --batch-mode dependency:resolve

# ------------------------------------------------------------
# Layer: Build
# ------------------------------------------------------------
COPY --chown=builder:builder src ./src

RUN --mount=type=cache,target=/home/builder/.m2,uid=${BUILDER_UID},gid=${BUILDER_GID} \
    ./mvnw --batch-mode -Pjvm -DskipTests clean verify

# ============================================================
# Stage 2: Runtime Environment
# ============================================================
# Distribute using a slim JRE-only image. Note: We do not require
# the UID to match the builder; we only need a non-root user.
FROM eclipse-temurin:25-jre-noble AS stage-runtime

LABEL maintainer="Emmanuel Bruno <emmanuel.bruno@univ-tln.fr>"
LABEL description="Java Hello World Application - multi-stage runtime"

RUN groupadd -r appgroup && useradd -r -g appgroup appuser && \
    mkdir -p /app && chown -R appuser:appgroup /app

# Deploy minimal runtime artifacts from the build stage
COPY --from=stage-build --chown=appuser:appgroup /app/target/hello-world-*-SNAPSHOT.jar /app/app.jar
COPY --from=stage-build --chown=appuser:appgroup /app/target/libs /app/libs

USER appuser
ENV HOME=/home/appuser

# JVM Container Ergonomics: JAVA_TOOL_OPTIONS is natively parsed by the
# JVM, enabling container-aware resource management.
ENV JAVA_TOOL_OPTIONS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

ENTRYPOINT ["java", "-jar", "/app/app.jar"]